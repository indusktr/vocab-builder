{
  "manifest_version": 3,
  "name": "Vocab Builder: Build Your Vocabulary",
  "version": "5.4.1",
  "description": "Build English vocabulary while you browse. Definitions, Synonyms & Flashcards. Best for SAT, IELTS, TOEFL, GRE.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}